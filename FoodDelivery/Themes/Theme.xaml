<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Color x:Key="ColorBg">#FFF6F7F9</Color>
    <Color x:Key="ColorSurface">#FFFFFFFF</Color>
    <Color x:Key="ColorSurface2">#FFF1F3F5</Color>
    <Color x:Key="ColorSurface3">#FFEFF2F6</Color>
    <Color x:Key="ColorBorder">#FFE5E7EB</Color>
    <Color x:Key="ColorText">#FF0F172A</Color>
    <Color x:Key="ColorTextMuted">#FF64748B</Color>
    <Color x:Key="ColorAccent">#FFEA1D2C</Color>
    <Color x:Key="ColorAccent2">#FFFF4D6D</Color>
    <Color x:Key="ColorAccentSoft">#1AEA1D2C</Color>
    <Color x:Key="ColorOverlay">#AA0F172A</Color>
    <Color x:Key="ColorDanger">#FFDC2626</Color>
    <Color x:Key="ColorWarn">#FFF59E0B</Color>
    <Color x:Key="ColorInfo">#FF2563EB</Color>

    <SolidColorBrush x:Key="BrushBg" Color="{StaticResource ColorBg}"/>
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="BrushSurface2" Color="{StaticResource ColorSurface2}"/>
    <SolidColorBrush x:Key="BrushSurface3" Color="{StaticResource ColorSurface3}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="BrushAccent2" Color="{StaticResource ColorAccent2}"/>
    <SolidColorBrush x:Key="BrushAccentSoft" Color="{StaticResource ColorAccentSoft}"/>
    <SolidColorBrush x:Key="BrushOverlay" Color="{StaticResource ColorOverlay}"/>
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}"/>
    <SolidColorBrush x:Key="BrushWarn" Color="{StaticResource ColorWarn}"/>
    <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource ColorInfo}"/>

    <LinearGradientBrush x:Key="BrushAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource ColorAccent}" Offset="0"/>
        <GradientStop Color="{StaticResource ColorAccent2}" Offset="1"/>
    </LinearGradientBrush>

    <DropShadowEffect x:Key="ShadowSm" BlurRadius="18" ShadowDepth="6" Direction="270" Opacity="0.10" Color="#000000"/>
    <DropShadowEffect x:Key="ShadowMd" BlurRadius="30" ShadowDepth="10" Direction="270" Opacity="0.14" Color="#000000"/>

    <Thickness x:Key="ThicknessPage">20</Thickness>
    <CornerRadius x:Key="RadiusMd">14</CornerRadius>
    <CornerRadius x:Key="RadiusSm">10</CornerRadius>
    <CornerRadius x:Key="RadiusLg">18</CornerRadius>

    <FontFamily x:Key="FontDefault">Segoe UI</FontFamily>

    <sys:Double x:Key="FontSizeTitle">28</sys:Double>
    <sys:Double x:Key="FontSizeH1">20</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
</ResourceDictionary>
