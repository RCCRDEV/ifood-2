<Page x:Class="FoodDelivery.Views.Pages.Restaurante.ProdutosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Produtos">
    <Grid Margin="{StaticResource ThicknessPage}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="Produtos" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                    <Button Content="Atualizar" Width="140" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Click="Refresh_Click"/>
                </DockPanel>
                <DataGrid Grid.Row="1" Margin="0,14,0,0" x:Name="ProdutosGrid" SelectionMode="Single" SelectionChanged="ProdutosGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" />
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="110" />
                        <DataGridTextColumn Header="Preço" Binding="{Binding Preco}" Width="120" />
                        <DataGridTextColumn Header="Ativo" Binding="{Binding Ativo}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Column="1" Margin="18,0,0,0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Cadastro" FontSize="18" FontWeight="SemiBold"/>

                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <TextBlock Text="Tipo" Foreground="{StaticResource BrushTextMuted}"/>
                    <ComboBox x:Name="TipoCombo" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock Text="Nome" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBox x:Name="NomeTextBox" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock Text="Descrição" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBox x:Name="DescricaoTextBox" Margin="0,8,0,0" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>

                <Grid Grid.Row="4" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Preço" Foreground="{StaticResource BrushTextMuted}"/>
                        <TextBox x:Name="PrecoTextBox" Margin="0,8,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Ativo" Foreground="{StaticResource BrushTextMuted}"/>
                        <ComboBox x:Name="AtivoCombo" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="5" Margin="0,14,0,0" Background="{StaticResource BrushSurface2}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Campos específicos" FontWeight="SemiBold"/>
                        <StackPanel Margin="0,10,0,0" x:Name="PratoFields">
                            <TextBlock Text="Tempo de preparo (min)" Foreground="{StaticResource BrushTextMuted}"/>
                            <TextBox x:Name="TempoPreparoTextBox" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0" x:Name="BebidaFields">
                            <TextBlock Text="Volume (ml)" Foreground="{StaticResource BrushTextMuted}"/>
                            <TextBox x:Name="VolumeMlTextBox" Margin="0,8,0,0"/>
                            <TextBlock Margin="0,10,0,0" Text="Alcoólica" Foreground="{StaticResource BrushTextMuted}"/>
                            <ComboBox x:Name="AlcoolicaCombo" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="6" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Novo" Width="110" Margin="0,0,10,0" Click="New_Click"/>
                    <Button Content="Excluir" Width="110" Margin="0,0,10,0" Click="Delete_Click"/>
                    <Button Content="Salvar" Width="110" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>

