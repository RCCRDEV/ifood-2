<Page x:Class="FoodDelivery.Views.Pages.Cliente.CarrinhoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Carrinho">
    <Grid Margin="{StaticResource ThicknessPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Carrinho" FontSize="18" FontWeight="SemiBold"/>

        <Border Grid.Row="1" Margin="0,14,0,0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="CartGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Produto" Binding="{Binding ProdutoNome}" Width="*" />
                        <DataGridTextColumn Header="Qtd" Binding="{Binding Quantidade}" Width="90" />
                        <DataGridTextColumn Header="Preço" Binding="{Binding Preco}" Width="120" />
                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal}" Width="140" />
                        <DataGridTemplateColumn Header="" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Remover" Click="Remove_Click" Tag="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <TextBlock Text="Observações (opcional)" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBox x:Name="ObsTextBox" Margin="0,8,0,0" Height="70" TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="TotalText" VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}"/>
            <Button Grid.Column="1" Content="Limpar" Width="140" Margin="0,0,10,0" Click="Clear_Click"/>
            <Button Grid.Column="2" Content="Fazer pedido" Width="160" Style="{StaticResource PrimaryButton}" Click="Checkout_Click"/>
        </Grid>
    </Grid>
</Page>

