<Page x:Class="FoodDelivery.Views.Pages.Restaurante.PedidosRestaurantePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Pedidos">
    <Grid Margin="{StaticResource ThicknessPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock Text="Pedidos do restaurante" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left"/>
            <Button Content="Atualizar" Width="140" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Click="Refresh_Click"/>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,14,0,0" Style="{StaticResource Card}">
            <DataGrid x:Name="PedidosGrid" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Binding="{Binding DataPedidoUtc}" Width="180" />
                    <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNome}" Width="*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="190" />
                    <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="140" />
                    <DataGridTextColumn Header="Motoboy" Binding="{Binding MotoboyNome}" Width="200" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Em preparo" Width="140" Margin="0,0,10,0" Click="EmPreparo_Click"/>
            <Button Content="Saiu p/ entrega" Width="160" Margin="0,0,10,0" Click="Saiu_Click"/>
            <Button Content="Entregue" Width="140" Style="{StaticResource PrimaryButton}" Click="Entregue_Click"/>
        </StackPanel>
    </Grid>
</Page>

