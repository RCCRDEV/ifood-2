<Page x:Class="FoodDelivery.Views.Pages.Cliente.PerfilClientePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Perfil">
    <Grid Margin="{StaticResource ThicknessPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock Text="Meu perfil" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left"/>
            <Button Content="Salvar" Width="140" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Click="Save_Click"/>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,14,0,0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.ColumnSpan="2">
                    <TextBlock Text="Nome" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBox x:Name="NomeTextBox" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,10,0">
                    <TextBlock Text="Telefone" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBox x:Name="TelefoneTextBox" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,14,0,0">
                    <TextBlock Text="E-mail" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBox x:Name="EmailTextBox" Margin="0,8,0,0" IsReadOnly="True"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0">
                    <TextBlock Text="Endereço" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBox x:Name="EnderecoTextBox" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>

