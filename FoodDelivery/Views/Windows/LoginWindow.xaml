<Window x:Class="FoodDelivery.Views.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoodDelivery • Login" Height="520" Width="860"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="{StaticResource RadiusLg}" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Effect="{StaticResource ShadowMd}">
            <Grid>
                <Border Background="{StaticResource BrushAccentGradient}" Opacity="0.12" CornerRadius="{StaticResource RadiusLg}"/>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Margin="28">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource BrushAccentGradient}" Margin="0,0,12,0">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF07100E"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="FoodDelivery" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeSmall}" Text="Sistema de delivery completo" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Margin="0,18,0,0" Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeBody}"
                               TextWrapping="Wrap"
                               Text="Interface moderna para clientes, restaurantes, motoboys e administração. Tudo em um só lugar."/>

                        <Border Margin="0,22,0,0" Background="{StaticResource BrushSurface2}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Acesso admin (demo)" FontWeight="SemiBold" />
                                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource BrushTextMuted}" Text="E-mail: admin@local" />
                                <TextBlock Foreground="{StaticResource BrushTextMuted}" Text="Senha: Admin123!" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24,0,0,0">
            <Border CornerRadius="{StaticResource RadiusLg}" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="24" Effect="{StaticResource ShadowMd}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Entrar" FontSize="{StaticResource FontSizeH1}" FontWeight="SemiBold" />

                    <StackPanel Grid.Row="1" Margin="0,20,0,0">
                        <TextBlock Text="E-mail" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBox x:Name="EmailTextBox" Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock Text="Senha" Foreground="{StaticResource BrushTextMuted}" />
                        <PasswordBox x:Name="PasswordBox" Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,22,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Criar conta" Width="140" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Click="CreateAccount_Click"/>
                        <Button Content="Entrar" Width="140" Style="{StaticResource PrimaryButton}" Click="Login_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Margin="0,18,0,0"
                               Foreground="{StaticResource BrushTextMuted}"
                               TextWrapping="Wrap"
                               Text="Dica: você pode criar contas de Cliente, Restaurante ou Motoboy na opção 'Criar conta'."/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
