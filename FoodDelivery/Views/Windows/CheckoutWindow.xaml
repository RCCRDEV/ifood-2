<Window x:Class="FoodDelivery.Views.Windows.CheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finalizar pedido" Height="620" Width="980"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusLg}" Padding="18" Effect="{StaticResource ShadowSm}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Pagamento" FontSize="{StaticResource FontSizeH1}" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Margin="0,8,0,0" Foreground="{StaticResource BrushTextMuted}"
                           Text="Escolha a forma de pagamento para confirmar o pedido."/>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <RadioButton x:Name="PixRadio" GroupName="pag" IsChecked="True" Style="{StaticResource PaymentOption}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="14" Background="{StaticResource BrushAccentSoft}" Margin="0,0,12,0">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource BrushAccent}" FontSize="16"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="PIX" FontWeight="SemiBold"/>
                                <TextBlock Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeSmall}" Text="Aprovação instantânea (simulada)"/>
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="CreditoRadio" GroupName="pag" Margin="0,10,0,0" Style="{StaticResource PaymentOption}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="14" Background="{StaticResource BrushSurface2}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,12,0">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" FontSize="16"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Cartão de crédito" FontWeight="SemiBold"/>
                                <TextBlock Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeSmall}" Text="Aprovação rápida (simulada)"/>
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="DebitoRadio" GroupName="pag" Margin="0,10,0,0" Style="{StaticResource PaymentOption}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="14" Background="{StaticResource BrushSurface2}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,12,0">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" FontSize="16"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Cartão de débito" FontWeight="SemiBold"/>
                                <TextBlock Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeSmall}" Text="Aprovação rápida (simulada)"/>
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="DinheiroRadio" GroupName="pag" Margin="0,10,0,0" Style="{StaticResource PaymentOption}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="14" Background="{StaticResource BrushSurface2}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,12,0">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" FontSize="16"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Dinheiro" FontWeight="SemiBold"/>
                                <TextBlock Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeSmall}" Text="Pagamento na entrega"/>
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusLg}" Padding="18" Effect="{StaticResource ShadowSm}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Resumo" FontSize="{StaticResource FontSizeH1}" FontWeight="SemiBold"/>

                <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl x:Name="ResumoItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Background="{StaticResource BrushSurface2}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ProdutoNome}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat=R$ {0:N2}}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Foreground="{StaticResource BrushTextMuted}"
                                                       Text="{Binding Quantidade, StringFormat=Qtd: {0}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,12,0,0" Text="Observações (opcional)" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBox x:Name="ObsTextBox" Margin="0,8,0,0" Height="70" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Margin="0,14,0,0" Background="{StaticResource BrushSurface2}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeSmall}" Text="Total"/>
                            <TextBlock x:Name="TotalText" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Voltar" Width="120" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                            <Button Content="Confirmar pedido" Width="170" Style="{StaticResource PrimaryButton}" Click="Confirm_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

