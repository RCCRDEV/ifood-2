<Page x:Class="FoodDelivery.Views.Pages.Admin.UsuariosAdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Usuários">
    <Grid Margin="{StaticResource ThicknessPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock Text="Usuários" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left"/>
            <Button Content="Atualizar" Width="140" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Click="Refresh_Click"/>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,14,0,0" Style="{StaticResource Card}">
            <DataGrid x:Name="Grid" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" />
                    <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="260" />
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="160" />
                    <DataGridTextColumn Header="Ativo" Binding="{Binding Ativo}" Width="90" />
                    <DataGridTemplateColumn Header="" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Alternar ativo" Click="Toggle_Click" Tag="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>

