<Page x:Class="FoodDelivery.Views.Pages.Admin.DashboardAdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard">
    <Grid Margin="{StaticResource ThicknessPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock Text="Dashboard" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left"/>
            <Button Content="Atualizar" Width="140" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Click="Refresh_Click"/>
        </DockPanel>

        <UniformGrid Grid.Row="1" Margin="0,14,0,0" Columns="4">
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Usuários" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBlock x:Name="UsuariosText" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Restaurantes" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBlock x:Name="RestaurantesText" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Pedidos" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBlock x:Name="PedidosText" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Pedidos hoje" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBlock x:Name="PedidosHojeText" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>
    </Grid>
</Page>

