<Page x:Class="FoodDelivery.Views.Pages.Motoboy.EntregasDisponiveisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Entregas">
    <Grid Margin="{StaticResource ThicknessPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock Text="Entregas disponíveis" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left"/>
            <Button Content="Atualizar" Width="140" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Click="Refresh_Click"/>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,14,0,0" Style="{StaticResource Card}">
            <DataGrid x:Name="Grid" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Binding="{Binding DataPedidoUtc}" Width="180" />
                    <DataGridTextColumn Header="Restaurante" Binding="{Binding RestauranteNome}" Width="*" />
                    <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNome}" Width="220" />
                    <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="140" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Aceitar entrega" Width="180" Style="{StaticResource PrimaryButton}" Click="Accept_Click"/>
        </StackPanel>
    </Grid>
</Page>

