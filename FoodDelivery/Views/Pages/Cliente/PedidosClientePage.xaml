<Page x:Class="FoodDelivery.Views.Pages.Cliente.PedidosClientePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:enums="clr-namespace:FoodDelivery.Models.Enums"
      Title="Pedidos">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>
    <Grid Margin="{StaticResource ThicknessPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock Text="Meus pedidos" FontSize="{StaticResource FontSizeH1}" FontWeight="SemiBold" DockPanel.Dock="Left"/>
            <Button Content="Atualizar" Width="140" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" Click="Refresh_Click"/>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,14,0,0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusLg}" Padding="16" Effect="{StaticResource ShadowSm}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border x:Name="EmptyOrdersPanel" Background="{StaticResource BrushSurface2}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="18" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Nenhum pedido ainda" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource BrushTextMuted}" Text="Quando você fizer um pedido, ele vai aparecer aqui com o status atualizado."/>
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="PedidosItems" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusLg}" Padding="14" Effect="{StaticResource ShadowSm}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding RestauranteNome}" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource BrushTextMuted}" Text="{Binding DataPedidoUtc, StringFormat={}{0:dd/MM/yyyy HH:mm}}"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" CornerRadius="999" Padding="10,6" Background="{StaticResource BrushSurface2}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:PedidoStatus.Entregue}">
                                                                <Setter Property="Foreground" Value="#FF047857"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:PedidoStatus.SaiuParaEntrega}">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushInfo}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:PedidoStatus.EmPreparo}">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushWarn}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:PedidoStatus.AguardandoConfirmacaoLoja}">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:PedidoStatus.Cancelado}">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Foreground="{StaticResource BrushTextMuted}" Text="{Binding Codigo, StringFormat=Código: {0}}"/>
                                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Total, StringFormat=Total: R$ {0:N2}}"/>
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Foreground="{StaticResource BrushTextMuted}" Text="{Binding PagamentoLabel}"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="Copiar código" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Click="CopyCode_Click"/>
                                                    <Button Content="Cancelar" Style="{StaticResource DangerButton}" IsEnabled="{Binding CanCancel}" Click="Cancel_Click"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource BrushTextMuted}" Text="{Binding Itens.Count, StringFormat=Itens: {0}}"/>
                                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource BrushDanger}"
                                                       Text="{Binding CancelamentoMotivo}"
                                                       Visibility="{Binding HasCancelamentoMotivo, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
