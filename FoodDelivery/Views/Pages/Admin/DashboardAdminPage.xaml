<Page x:Class="FoodDelivery.Views.Pages.Admin.DashboardAdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard">
    <Grid Margin="{StaticResource ThicknessPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock Text="Dashboard" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left"/>
            <Button Content="Atualizar" Width="140" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Click="Refresh_Click"/>
        </DockPanel>

        <UniformGrid Grid.Row="1" Margin="0,14,0,0" Columns="4">
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="12" Background="{StaticResource BrushAccentSoft}" Margin="0,0,10,0">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource BrushAccent2}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Usuários" Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeSmall}"/>
                            <TextBlock x:Name="UsuariosText" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="12" Background="{StaticResource BrushAccentSoft}" Margin="0,0,10,0">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource BrushAccent}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Restaurantes" Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeSmall}"/>
                            <TextBlock x:Name="RestaurantesText" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="12" Background="{StaticResource BrushSurface2}" Margin="0,0,10,0">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource BrushWarn}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Pedidos" Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeSmall}"/>
                            <TextBlock x:Name="PedidosText" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="12" Background="{StaticResource BrushSurface2}" Margin="0,0,10,0">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource BrushInfo}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Pedidos hoje" Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeSmall}"/>
                            <TextBlock x:Name="PedidosHojeText" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>
    </Grid>
</Page>
