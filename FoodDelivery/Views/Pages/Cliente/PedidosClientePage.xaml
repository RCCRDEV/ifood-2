<Page x:Class="FoodDelivery.Views.Pages.Cliente.PedidosClientePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Pedidos">
    <Grid Margin="{StaticResource ThicknessPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock Text="Meus pedidos" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left"/>
            <Button Content="Atualizar" Width="140" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Click="Refresh_Click"/>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,14,0,0" Style="{StaticResource Card}">
            <DataGrid x:Name="PedidosGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Binding="{Binding DataPedidoUtc}" Width="180" />
                    <DataGridTextColumn Header="Restaurante" Binding="{Binding RestauranteNome}" Width="*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="180" />
                    <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="140" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>

