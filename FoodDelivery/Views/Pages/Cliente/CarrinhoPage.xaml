<Page x:Class="FoodDelivery.Views.Pages.Cliente.CarrinhoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Carrinho">
    <Grid Margin="{StaticResource ThicknessPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Carrinho" FontSize="{StaticResource FontSizeH1}" FontWeight="SemiBold"/>

        <Border Grid.Row="1" Margin="0,14,0,0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusLg}" Padding="16" Effect="{StaticResource ShadowSm}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border x:Name="EmptyCartPanel" Background="{StaticResource BrushSurface2}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="18" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Seu carrinho está vazio" FontWeight="SemiBold" FontSize="16"/>
                                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource BrushTextMuted}" Text="Volte aos restaurantes e adicione itens para finalizar o pedido."/>
                                </StackPanel>
                            </Border>

                            <ItemsControl x:Name="CartItems" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusLg}" Padding="14" Effect="{StaticResource ShadowSm}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding ProdutoNome}" FontWeight="SemiBold" FontSize="15"/>
                                                <Button Grid.Column="1" Content="Remover" Style="{StaticResource SecondaryButton}" Padding="12,8" MinHeight="36" Click="Remove_Click" Tag="{Binding}"/>

                                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Orientation="Horizontal">
                                                    <Border Background="{StaticResource BrushAccentSoft}" CornerRadius="10" Padding="8,4" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Quantidade, StringFormat=Qtd: {0}}" Foreground="{StaticResource BrushAccent}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Preco, StringFormat=Preço: R$ {0:N2}}" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                                    <TextBlock Text="{Binding Subtotal, StringFormat=Subtotal: R$ {0:N2}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock Text="Observações (opcional)" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBox x:Name="ObsTextBox" Margin="0,8,0,0" Height="70" TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,14,0,0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusLg}" Padding="14" Effect="{StaticResource ShadowSm}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeSmall}" Text="Total do pedido"/>
                    <TextBlock x:Name="TotalText" FontWeight="SemiBold" FontSize="18" Margin="0,6,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Limpar" Width="140" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Click="Clear_Click"/>
                <Button Grid.Column="2" Content="Fazer pedido" Width="170" Style="{StaticResource PrimaryButton}" Click="Checkout_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>
